{
  "manifest_version": 3,
  "name": "ProcEasy Clipboard Assistant",
  "version": "0.2.0",
  "description": "Premium assistive ProcEasy widget: AssistiveTouch dot, clipboard/drag-drop invoice capture, and draggable extracted fields.",
  "permissions": ["activeTab", "clipboardRead", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_title": "ProcEasy Assistant",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["data.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
